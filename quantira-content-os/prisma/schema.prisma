generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id              Int              @id @default(autoincrement())
  clientId        String           @unique
  clientName      String           @unique
  industry        String?
  accountManager  String?
  monthlyRetainer Float?           @default(0)
  startDate       DateTime?
  status          String           @default("Active")
  campaigns       Campaign[]
  contentMaster   ContentMaster[]
  requests        ContentRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Campaign {
  id              Int             @id @default(autoincrement())
  campaignId      String          @unique
  clientId        String
  client          Client          @relation(fields: [clientId], references: [clientName], onDelete: Cascade)
  campaignName    String
  goal            String?
  budget          Float?
  startDate       DateTime?
  endDate         DateTime?
  status          String          @default("Planning")
  expectedLeads   Int?            @default(0)
  expectedRevenue Float?          @default(0)
  contentMaster   ContentMaster[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ContentMaster {
  id                 Int                 @id @default(autoincrement())
  contentId          String              @unique
  campaignId         String?
  campaign           Campaign?           @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [clientName], onDelete: SetNull)
  contentTitle       String
  topic              String?
  contentPillar      String?
  funnelStage        String?
  targetPersona      String?
  painPoint          String?
  contentAngle       String?
  platform           String
  contentFormat      String?
  language           String              @default("English")
  objective          String?
  cta                String?
  priority           String              @default("Normal")
  owner              String?
  publishDate        DateTime?
  publishTime        String?
  status             String              @default("Draft")
  daysRemaining      Int?                @default(0)
  healthStatus       String              @default("On Track")
  month              String?
  week               Int?
  quarter            String?
  caption            String?
  hashtags           String?
  canvaLink          String?
  driveLink          String?
  contentProduction  ContentProduction?
  performanceTracker PerformanceTracker?
  contentScorecard   ContentScorecard?
  approval           Approval?
  assets             Asset[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ContentProduction {
  productionId    Int            @id @default(autoincrement())
  contentId       String         @unique
  content         ContentMaster  @relation(fields: [contentId], references: [contentId], onDelete: Cascade)
  copywriter      String?
  writerStatus    String?        @default("Draft")
  designer        String?
  designStatus    String?        @default("Not Required")
  videoEditor     String?
  editingStatus   String?        @default("Not Required")
  revisionCount   Int            @default(0)
  lastUpdated     DateTime       @default(now()) @updatedAt
}

model PerformanceTracker {
  id               String        @id @default(cuid())
  contentId        String        @unique
  content          ContentMaster @relation(fields: [contentId], references: [contentId], onDelete: Cascade)
  
  reach            Int           @default(0)
  impressions      Int           @default(0)
  likes            Int           @default(0)
  comments         Int           @default(0)
  shares           Int           @default(0)
  saves            Int           @default(0)
  profileVisits    Int           @default(0)
  linkClicks       Int           @default(0)
  leadsGenerated   Int           @default(0)
  revenueGenerated Float         @default(0)
  engagementRate   Float         @default(0)
  contentScore     Float         @default(0)
  
  updatedAt        DateTime      @updatedAt
}

model ContentScorecard {
  id              String        @id @default(cuid())
  contentId       String        @unique
  content         ContentMaster @relation(fields: [contentId], references: [contentId], onDelete: Cascade)
  
  reachScore      Float         @default(0)
  engagementScore Float         @default(0)
  leadScore       Float         @default(0)
  conversionScore Float         @default(0)
  overallScore    Float         @default(0)
  
  updatedAt       DateTime      @updatedAt
}

model Approval {
  approvalId        Int            @id @default(autoincrement())
  contentId         String         @unique
  content           ContentMaster  @relation(fields: [contentId], references: [contentId], onDelete: Cascade)
  approvalStatus    String         @default("Pending")
  submittedBy       String?
  reviewer          String?
  revisionRound     Int            @default(1)
  feedback          String?
  finalApprovalDate DateTime?
  createdAt         DateTime       @default(now())
  lastUpdated       DateTime       @default(now()) @updatedAt
}

model ContentRequest {
  requestId       Int            @id @default(autoincrement())
  client          String
  clientRelation  Client         @relation(fields: [client], references: [clientName], onDelete: Cascade)
  requestTitle    String?
  description     String?
  requestedBy     String?
  requestDate     DateTime       @default(now())
  status          String         @default("Open")
  platform        String?
  contentType     String?
  priority        String         @default("Normal")
  objective       String?
  brief           String?
  dueDate         DateTime?
  assignedTo      String?
}

model AuditLog {
  logId           Int            @id @default(autoincrement())
  timestamp       DateTime       @default(now())
  username        String?
  action          String?
  tableName       String?
  recordId        String?
  oldValue        String?
  newValue        String?
}

model ContentStrategy {
  id            String   @id @default(cuid())
  topic         String
  industry      String?
  persona       String?
  funnelStage   String?
  searchIntent  String?
  contentPillar String?
  keyword       String?
  competitorRef String?
  priority      String   @default("Normal")
  ideaStatus    String   @default("Brainstorm")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Asset {
  id          String        @id @default(cuid())
  contentId   String
  content     ContentMaster @relation(fields: [contentId], references: [contentId], onDelete: Cascade)
  assetType   String
  canvaLink   String?
  driveLink   String?
  version     Int           @default(1)
  uploadDate  DateTime      @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("REVIEWER")
  avatar        String?
  clientName    String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


